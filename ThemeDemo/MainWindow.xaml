<Window x:Class="ThemeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pt="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme"
        xmlns:th="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Theme"
        xmlns:local="clr-namespace:ThemeDemo"
        Title="PresentationFramework.Theme Gallery"
        Width="1120" Height="1320"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Open..." />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" />
                <MenuItem Header="_Redo" />
                <Separator />
                <MenuItem Header="Cu_t" />
                <MenuItem Header="_Copy" />
                <MenuItem Header="_Paste" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" />
                <MenuItem Header="Zoom _Out" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <Separator />
            <StatusBarItem Content="PresentationFramework.Theme" />
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12,20,20">
            <StackPanel>
                <TextBlock Text="Win32 theme for WPF" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="ModeText" Margin="0,4,0,2" Foreground="Gray" />
                <TextBlock Margin="0,2,0,12" Foreground="Gray"
                           Text="Mapped controls use the current UXTHEME parts; the state strip shows every state. Controls without a Win32 mapping still use the WPF built-in style." />

                <!-- ================= Mapped controls ================= -->
                <TextBlock Text="Mapped controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Button" Width="100" Height="30" Margin="0,0,8,8" />
                            <Button Content="Default" Width="100" Height="30" Margin="0,0,8,8" IsDefault="True" />
                            <Button Content="Disabled" Width="100" Height="30" Margin="0,0,8,8" IsEnabled="False" />
                            <RepeatButton Content="RepeatButton" Width="120" Height="30" Margin="0,0,8,8" />
                            <ToggleButton Content="ToggleButton" Width="120" Height="30" Margin="0,0,8,8" IsChecked="True" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="Unchecked" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Checked" IsChecked="True" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Disabled" IsEnabled="False" Margin="0,0,18,8" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton Content="Option A" GroupName="G1" IsChecked="True" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <RadioButton Content="Option B" GroupName="G1" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <RadioButton Content="Disabled" GroupName="G2" IsEnabled="False" Margin="0,0,18,8" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Text="TextBox" Width="180" Margin="0,0,10,8" />
                            <TextBox Text="Read only" Width="180" IsReadOnly="True" Margin="0,0,10,8" />
                            <TextBox Text="Disabled" Width="180" IsEnabled="False" Margin="0,0,10,8" />
                            <PasswordBox x:Name="SamplePassword" Width="180" Margin="0,0,10,8" />
                            <RichTextBox Width="300" Height="80" Margin="0,0,10,8">
                                <FlowDocument>
                                    <Paragraph>RichTextBox uses the same Win32 Edit part as TextBox.</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ================= State strip ================= -->
                <TextBlock Text="Every Win32 state of the mapped parts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Button / BP_PUSHBUTTON (part 1)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="5 Default" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="6" /><TextBlock Text="6 DefaultAnimating" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="CheckBox / BP_CHECKBOX (Button part 3)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="1" /><TextBlock Text="1 Unchecked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="5" /><TextBlock Text="5 Checked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="6" /><TextBlock Text="6 CheckedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="7" /><TextBlock Text="7 CheckedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="8" /><TextBlock Text="8 CheckedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="9" /><TextBlock Text="9 Mixed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="10" /><TextBlock Text="10 MixedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="11" /><TextBlock Text="11 MixedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="12" /><TextBlock Text="12 MixedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="RadioButton / BP_RADIOBUTTON (Button part 2)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="1" /><TextBlock Text="1 Unchecked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="5" /><TextBlock Text="5 Checked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="6" /><TextBlock Text="6 CheckedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="7" /><TextBlock Text="7 CheckedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="8" /><TextBlock Text="8 CheckedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="TextBox / EP_EDITTEXT (Edit part 1)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="3" /><TextBlock Text="3 Focused" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="5 ReadOnly" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Raw parts: ScrollBar / GroupBox / Tab / Menu / Tooltip / Status" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="17" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Scroll up" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="17" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="Scroll down" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="55" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="3" th:ThemeImage.State="1" /><TextBlock Text="Thumb" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="180" Height="70" th:ThemeImage.Class="Button" th:ThemeImage.Part="4" th:ThemeImage.State="1" /><TextBlock Text="GroupBox" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="120" Height="28" th:ThemeImage.Class="Tab" th:ThemeImage.Part="5" th:ThemeImage.State="3" /><TextBlock Text="Tab" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="22" th:ThemeImage.Class="Menu" th:ThemeImage.Part="14" th:ThemeImage.State="1" /><TextBlock Text="Menu item" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="40" th:ThemeImage.Class="Tooltip" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Tooltip" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="26" th:ThemeImage.Class="Status" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Status" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="ThemePart probe" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="TrackBar" PartId="9" StateId="1" Width="240" Height="18" /><TextBlock Text="TICS 9" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="TrackBar" PartId="10" StateId="1" Width="18" Height="100" /><TextBlock Text="TICSVERT 10" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="5" StateId="1" Width="200" Height="27" /><TextBlock Text="Combo RO 5" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="5" StateId="2" Width="200" Height="27" /><TextBlock Text="Combo RO 5 s2" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="1" Width="18" Height="22" /><TextBlock Text="DD 1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="2" Width="18" Height="22" /><TextBlock Text="DD 2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="3" Width="18" Height="22" /><TextBlock Text="DD 3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="4" Width="18" Height="22" /><TextBlock Text="DD 4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Header" PartId="2" StateId="1" Width="40" Height="22" /><TextBlock Text="Header 2" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Header" PartId="3" StateId="1" Width="40" Height="22" /><TextBlock Text="Header 3" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ Taskbar / tray backgrounds (public template keys) ============ -->
                <TextBlock Text="Taskbar / tray backgrounds (public resource keys)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                                   Text="Consumed from outside the theme assembly by resource key: ThemeResourceKeys.TaskbarBackgroundBottom / TaskbarBackgroundRight / TrayNotifyBackground. Each key is a ControlTemplate whose root is a single HackImage, stretched to fill its slot. ThemeResourceKeys.TaskbarForeground and TrayNotifyForeground are Brushes read from Toolbar [TaskBar] and TrayNotify [TrayNotifyHoriz] TMT_TEXTCOLOR. The slot backdrop is tinted so you can tell a part that drew nothing from one that drew white: on Windows 10/11 the live Aero TaskBar parts are flat white (the real taskbar is composited by DWM) and the TrayNotify class no longer exists, so the third slot stays tinted. Against an XP/Longhorn-era visual style these render as the real taskbar art." />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskBar part 1 &#8212; TBP_BACKGROUNDBOTTOM" FontWeight="SemiBold" />
                                <TextBlock Text="bottom edge (horizontal bar)" FontSize="10" Foreground="Gray" Margin="0,1,0,4" />
                                <Border Width="330" Height="36" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundBottom}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskBar part 5 &#8212; TBP_SIZINGBARBOTTOM" FontWeight="SemiBold" />
                                <TextBlock Text="sizing bar (bottom edge)" FontSize="10" Foreground="Gray" Margin="0,1,0,4" />
                                <Border Width="330" Height="20" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarSizingBarBottom}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskBar part 2 &#8212; TBP_BACKGROUNDRIGHT" FontWeight="SemiBold" />
                                <TextBlock Text="right edge (vertical bar)" FontSize="10" Foreground="Gray" Margin="0,1,0,4" />
                                <Border Width="60" Height="120" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundRight}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskBar bottom rotated 90&#176; CCW" FontWeight="SemiBold" />
                                <TextBlock Text="derived vertical (TBP_BACKGROUNDBOTTOM, -90&#176;)" FontSize="10" Foreground="Gray" Margin="0,1,0,4" />
                                <Border Width="60" Height="120" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundBottomRotated}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TrayNotify [TrayNotifyHoriz] part 1 &#8212; TNP_BACKGROUND" FontWeight="SemiBold" />
                                <TextBlock Text="bottom edge (notification area)" FontSize="10" Foreground="Gray" Margin="0,1,0,4" />
                                <Border Width="200" Height="36" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TrayNotifyBackground}}" />
                                </Border>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Taskbar foreground:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Width="330" Height="28" BorderBrush="#FF808080" BorderThickness="1" Background="#FF303342">
                                <TextBlock Text="Taskbar foreground"
                                           Foreground="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarForeground}}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Border>
                            <Border Width="220" Height="28" BorderBrush="#FF808080" BorderThickness="1" Background="#FF303342" Margin="16,0,0,0">
                                <TextBlock Text="TrayNotify foreground"
                                           Foreground="{DynamicResource {x:Static th:ThemeResourceKeys.TrayNotifyForeground}}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ThemeTaskbarForegroundBrush / ThemeTrayNotifyForegroundBrush" Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <!-- ============ HackImage vs HackBorder: measurement ============ -->
                        <TextBlock Text="HackImage vs HackBorder &#8212; measurement" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="Same ControlTemplate content, same uxTheme part; only the element type differs. Each box below is Auto-width (HorizontalAlignment=Left) and sits directly in a vertical StackPanel, so the panel offers it a finite width and the box's width IS the element's DesiredSize. HackImage hands the offered width back as its desired size (once its part has loaded), so its box can span the whole row. HackBorder no longer claims the bitmap at all: like the reference Slice9Image it reports only the fixed slice border (HackThickness plus BorderThickness), so its box collapses to that floor and the parent decides the rest. With a slice thickness of 3 the floor is 6 px, so the box collapses to the slice border; the parent decides the rest. That is why a SizeToContent window grows with one and not the other. The printed widths are ActualWidth bindings, so the numbers come from the layout pass rather than from this caption." />
                        <TextBlock Text="HackImage (values the offered size back)" FontWeight="SemiBold" />
                        <Border x:Name="MeasureImageBox" HorizontalAlignment="Left" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                            <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundBottom}}" />
                        </Border>
                        <TextBlock Text="{Binding ActualWidth, ElementName=MeasureImageBox, StringFormat=measured width {0:F0} px}" Foreground="Gray" FontSize="10" Margin="0,2,0,0" />
                        <TextBlock Text="HackBorder (only the slice border, like Slice9Image)" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <Border x:Name="MeasureBorderBox" HorizontalAlignment="Left" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                            <pt:HackBorder HackThickness="3" th:ThemeImage.Class="TaskBar" th:ThemeImage.Part="1" th:ThemeImage.State="0" th:ThemeImage.RenderMode="Natural" th:ThemeImage.PreserveAlpha="True" />
                        </Border>
                        <TextBlock Text="{Binding ActualWidth, ElementName=MeasureBorderBox, StringFormat=measured width {0:F0} px}" Foreground="Gray" FontSize="10" Margin="0,2,0,0" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,6,0,0"
                                   Text="The bounded variants also exist for the other two backgrounds: TaskbarBackgroundRightBounded and TrayNotifyBackgroundBounded. Rendering is identical to the HackImage family; only measurement differs, and the floor is HackThickness (3 px here) plus the border line." />

                        <!-- ============ HackBorder: Border semantics + theme part ============ -->
                        <TextBlock Text="HackBorder &#8212; Border semantics plus a theme part" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="HackBorder derives from Border, so Background, BorderBrush, BorderThickness, CornerRadius and Padding are the real Border properties, and the child is written directly in XAML. The theme part (TaskBar part 1) is painted inside the border line and clipped to the corner radius; Padding affects only the child. The second box sets Foreground on the HackBorder and does not set it on the TextBlock, so the inherited text colour proves the Foreground property forwards to TextElement.Foreground." />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="theme part, no child" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <pt:HackBorder Width="240" Height="36" Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                               BorderThickness="2" CornerRadius="8"
                                               th:ThemeImage.Class="TaskBar" th:ThemeImage.Part="1" th:ThemeImage.State="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="child + Padding=12 + Foreground" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <pt:HackBorder Width="240" Height="72" Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                               BorderThickness="2" CornerRadius="8" Padding="12"
                                               Foreground="#FF203040"
                                               th:ThemeImage.Class="TaskBar" th:ThemeImage.Part="1" th:ThemeImage.State="0">
                                    <TextBlock TextWrapping="Wrap" Text="child content inherits Foreground, inset by Padding" />
                                </pt:HackBorder>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="SubClass reaches the part" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <pt:HackBorder Width="240" Height="36" Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                               BorderThickness="2" CornerRadius="8"
                                               th:ThemeImage.Class="TrayNotify" th:ThemeImage.SubClass="TrayNotifyHoriz"
                                               th:ThemeImage.Part="1" th:ThemeImage.State="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="no theme part: Background only" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <pt:HackBorder Width="240" Height="36" Background="#FFC8DCF0" BorderBrush="#FF6080A0"
                                               BorderThickness="2" CornerRadius="8" Padding="12">
                                    <TextBlock Text="plain Border usage" />
                                </pt:HackBorder>
                            </StackPanel>
                        </WrapPanel>

                        <!-- ============ All three bounded HackBorder keys ============ -->
                        <TextBlock Text="Bounded HackBorder keys &#8212; all three backgrounds" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="The three HackBorder-based ControlTemplate keys, consumed the same way as the HackImage family (x:Static on ThemeResourceKeys, applied via Template). Rendering is identical; measurement is the difference. TaskbarBackgroundBottomBounded and TaskbarBackgroundRightBounded cover the two edges the taskbar can dock against; TrayNotifyBackgroundBounded is the notification area." />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskbarBackgroundBottomBounded" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <Border Width="240" Height="36" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundBottomBounded}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TaskbarBackgroundRightBounded" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <Border Width="60" Height="120" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TaskbarBackgroundRightBounded}}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,10">
                                <TextBlock Text="TrayNotifyBackgroundBounded" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                                <Border Width="200" Height="36" BorderBrush="#FF808080" BorderThickness="1" Background="#FFFFF0C0">
                                    <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.TrayNotifyBackgroundBounded}}" />
                                </Border>
                            </StackPanel>
                        </WrapPanel>

                        <!-- ============ HackBorder + ThemeImage.TransitionDuration ============ -->
                        <TextBlock Text="HackBorder + ThemeImage.TransitionDuration" FontWeight="SemiBold" Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="Hover the box: the state goes 1 to 2 through a Style trigger on the HackBorder itself. That exercises the whole descriptor path — the trigger writes ThemeImage.State on the border, the indirection hands it to the inner HackImage, and the cross-fade runs there. It uses Button part 1 (BP_PUSHBUTTON) because that part actually defines both states; a hover on a taskbar part proves nothing. The fade length comes from the ThemeTransitionDuration resource: 0 in the plain theme (instant switch) and 0.15s in theme.withtransition, so run with --transition to see the animation." />
                        <pt:HackBorder x:Name="TransitionProbe" Width="240" Height="40" Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                       BorderThickness="2" CornerRadius="8"
                                       th:ThemeImage.Class="Button" th:ThemeImage.Part="1"
                                       th:ThemeImage.TransitionDuration="{DynamicResource ThemeTransitionDuration}">
                            <pt:HackBorder.Style>
                                <Style TargetType="pt:HackBorder">
                                    <!-- Default state must be a Style SETTER here, never a local attribute
                                         on the HackBorder element. A local value outranks Style triggers,
                                         so writing th:ThemeImage.State on the element itself pins it and
                                         the trigger below can never win (WPF precedence, local > trigger). -->
                                    <Setter Property="th:ThemeImage.State" Value="1" />
                                    <Style.Triggers>
                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                            <Setter Property="th:ThemeImage.State" Value="2" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </pt:HackBorder.Style>
                        </pt:HackBorder>

                        <!-- The two Aero states differ only slightly in fill (E1E1E1 to E5F1FB), so the
                             number is the reliable way to see that the trigger really fired. -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="ThemeImage.State right now: " Foreground="Gray" />
                            <TextBlock x:Name="StateReadout" FontWeight="Bold" Foreground="#FF005499"
                                       Text="{Binding Path=(th:ThemeImage.State), ElementName=TransitionProbe}" />
                            <TextBlock Text="   (1 = normal, 2 = hot)" Foreground="Gray" />
                        </StackPanel>

                        <!-- ============ A Button whose whole visual is one HackBorder ============ -->
                        <TextBlock Text="Button built from a single HackBorder" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                                   Text="A normal Button whose ControlTemplate root is one pt:HackBorder and nothing else: no Button chrome, no Border, no theme Button style. Everything visible comes from HackBorder — Background, BorderBrush, BorderThickness, CornerRadius and Padding are Border properties, the surface is Button part 1, and the label is the Button's Content going through the HackBorder child slot. The three states are driven from the templated parent: hover goes to 2, pressed to 3, disabled to 4. Hover it to see the cross-fade when running with --transition." />
                        <WrapPanel>
                            <Button Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <pt:HackBorder Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                                       BorderThickness="1" CornerRadius="6" Padding="16,7"
                                                       th:ThemeImage.Class="Button" th:ThemeImage.Part="1"
                                                       th:ThemeImage.RenderMode="Natural" th:ThemeImage.PreserveAlpha="True"
                                                       th:ThemeImage.TransitionDuration="{DynamicResource ThemeTransitionDuration}">
                                            <pt:HackBorder.Style>
                                                <Style TargetType="pt:HackBorder">
                                                    <Setter Property="th:ThemeImage.State" Value="1" />
                                                    <Style.Triggers>
                                                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                                                            <Setter Property="th:ThemeImage.State" Value="2" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                            <Setter Property="th:ThemeImage.State" Value="3" />
                                                        </DataTrigger>
                                                        <Trigger Property="UIElement.IsEnabled" Value="False">
                                                            <Setter Property="th:ThemeImage.State" Value="4" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </pt:HackBorder.Style>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </pt:HackBorder>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="HackBorder button" />
                            </Button>
                            <Button Padding="0" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                    IsEnabled="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <pt:HackBorder Background="#FFFFF0C0" BorderBrush="#FF6080A0"
                                                       BorderThickness="1" CornerRadius="6" Padding="16,7"
                                                       th:ThemeImage.Class="Button" th:ThemeImage.Part="1"
                                                       th:ThemeImage.RenderMode="Natural" th:ThemeImage.PreserveAlpha="True">
                                            <pt:HackBorder.Style>
                                                <Style TargetType="pt:HackBorder">
                                                    <Setter Property="th:ThemeImage.State" Value="1" />
                                                    <Style.Triggers>
                                                        <Trigger Property="UIElement.IsEnabled" Value="False">
                                                            <Setter Property="th:ThemeImage.State" Value="4" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </pt:HackBorder.Style>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </pt:HackBorder>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="disabled" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ HackButton / HackRepeatButton / HackToggleButton ============ -->
                <TextBlock Text="HackButton / HackRepeatButton / HackToggleButton" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style x:Key="DemoHackButton" TargetType="{x:Type pt:HackButton}">
                            <Setter Property="NormalSource" Value="{x:Static local:HackButtonDemoSources.Normal}" />
                            <Setter Property="HoverSource" Value="{x:Static local:HackButtonDemoSources.Hover}" />
                            <Setter Property="ActiveSource" Value="{x:Static local:HackButtonDemoSources.Active}" />
                            <Setter Property="FocusSource" Value="{x:Static local:HackButtonDemoSources.Focus}" />
                            <Setter Property="DisabledSource" Value="{x:Static local:HackButtonDemoSources.Disabled}" />
                            <Setter Property="HackThickness" Value="3" />
                            <Setter Property="TransitionDuration" Value="0:0:0.15" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style x:Key="DemoHackRepeatButton" TargetType="{x:Type pt:HackRepeatButton}">
                            <Setter Property="NormalSource" Value="{x:Static local:HackButtonDemoSources.Normal}" />
                            <Setter Property="HoverSource" Value="{x:Static local:HackButtonDemoSources.Hover}" />
                            <Setter Property="ActiveSource" Value="{x:Static local:HackButtonDemoSources.Active}" />
                            <Setter Property="FocusSource" Value="{x:Static local:HackButtonDemoSources.Focus}" />
                            <Setter Property="DisabledSource" Value="{x:Static local:HackButtonDemoSources.Disabled}" />
                            <Setter Property="HackThickness" Value="3" />
                            <Setter Property="TransitionDuration" Value="0:0:0.15" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style x:Key="DemoHackToggleButton" TargetType="{x:Type pt:HackToggleButton}">
                            <Setter Property="NormalSource" Value="{x:Static local:HackButtonDemoSources.Normal}" />
                            <Setter Property="HoverSource" Value="{x:Static local:HackButtonDemoSources.Hover}" />
                            <Setter Property="ActiveSource" Value="{x:Static local:HackButtonDemoSources.Active}" />
                            <Setter Property="FocusSource" Value="{x:Static local:HackButtonDemoSources.Focus}" />
                            <Setter Property="DisabledSource" Value="{x:Static local:HackButtonDemoSources.Disabled}" />
                            <Setter Property="HackThickness" Value="3" />
                            <Setter Property="TransitionDuration" Value="0:0:0.15" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                        <Style x:Key="DemoHackButtonNormalOnly" TargetType="{x:Type pt:HackButton}">
                            <Setter Property="NormalSource" Value="{x:Static local:HackButtonDemoSources.Normal}" />
                            <Setter Property="HackThickness" Value="3" />
                            <Setter Property="TransitionDuration" Value="0:0:0.15" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </StackPanel.Resources>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                           Text="Convenience controls, deliberately not part of the theme: you hand each one five bitmaps plus a HackThickness, and it picks between them from IsMouseOver / IsPressed / IsKeyboardFocused / IsEnabled. The art below is the one WpfApplicationTest uses — PNGFILE1150_1 through PNGFILE1154_1, 109x24 with a 3 pixel border — so HackThickness=&quot;3&quot; leaves the rounded corners alone while the middle stretches. Hover, press, Tab onto and disable them: the image swaps, and a missing state falls back to the one before it. TransitionDuration is 0.15s here, so the swap is a cross-fade through the same HackImageTransitions code the attached properties use; set it to zero for an instant swap. HackToggleButton carries five more — CheckedNormal / CheckedHover / CheckedActive / CheckedFocus / CheckedDisabled — used only while IsChecked is true; leave them unset and it falls back to the plain five, with a checked button resting on ActiveSource. Once any Checked* is set, the checked state uses its own set: a missing checked variant falls back to CheckedNormal, never to the unchecked image of that state." />
                <WrapPanel>
                    <pt:HackButton Style="{StaticResource DemoHackButton}" Content="HackButton" />
                    <pt:HackButton Style="{StaticResource DemoHackButton}" Content="disabled" IsEnabled="False" />
                    <pt:HackRepeatButton Style="{StaticResource DemoHackRepeatButton}" Content="HackRepeatButton" />
                    <pt:HackToggleButton Style="{StaticResource DemoHackToggleButton}" Content="toggle, unchecked" />
                    <pt:HackToggleButton Style="{StaticResource DemoHackToggleButton}" Content="toggle, checked" IsChecked="True" />
                </WrapPanel>
                <WrapPanel>
                    <pt:HackButton Style="{StaticResource DemoHackButton}" Content="stretched — the 3px border stays 3px" />
                    <pt:HackButton Style="{StaticResource DemoHackButton}" Content="taller" Padding="14,14" />
                    <pt:HackButton Style="{StaticResource DemoHackButtonNormalOnly}" Content="normal only — no hover image to fall back to" />
                </WrapPanel>

                </StackPanel>
                </Border>

                <TextBlock Text="Window borders / content (ControlTemplates)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="Normal active window" FontWeight="SemiBold" />
                            <TextBlock Text="caption + left/right/bottom from system non-client metrics" FontSize="10" Foreground="Gray" Margin="0,1,0,2" />
                            <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Measured corners: TL {0:0.##}  TR {1:0.##}  BL {2:0.##}  BR {3:0.##}">
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.NormalWindowTopLeftCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.NormalWindowTopRightCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.NormalWindowBottomLeftCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.NormalWindowBottomRightCornerRadius}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Width="280" Height="170">
                                <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.NormalWindowBorder}}" />
                                <Grid VerticalAlignment="Top" Height="{DynamicResource {x:Static th:ThemeResourceKeys.NormalWindowTitleHeight}}">
