                                               FontSize="{DynamicResource {x:Static th:ThemeResourceKeys.NormalWindowTitleFontSize}}"
                                               FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="Window content" Foreground="{DynamicResource {x:Static th:ThemeResourceKeys.WindowContentForeground}}"
                                           Margin="{DynamicResource {x:Static th:ThemeResourceKeys.NormalWindowContentMargin}}" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12">
                            <TextBlock Text="Tool window (active)" FontWeight="SemiBold" />
                            <TextBlock Text="small caption + system non-client metrics" FontSize="10" Foreground="Gray" Margin="0,1,0,2" />
                            <TextBlock FontSize="10" Foreground="Gray" Margin="0,0,0,4">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Measured corners: TL {0:0.##}  TR {1:0.##}  BL {2:0.##}  BR {3:0.##}">
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.ToolWindowTopLeftCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.ToolWindowTopRightCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.ToolWindowBottomLeftCornerRadius}" />
                                        <Binding Source="{x:Static th:ThemeWindowMetrics.ToolWindowBottomRightCornerRadius}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Width="280" Height="170">
                                <Control Template="{DynamicResource {x:Static th:ThemeResourceKeys.ToolWindowBorder}}" />
                                <Grid VerticalAlignment="Top" Height="{DynamicResource {x:Static th:ThemeResourceKeys.ToolWindowTitleHeight}}">
                                    <TextBlock Text="Tool window" Foreground="{DynamicResource {x:Static th:ThemeResourceKeys.ToolWindowForeground}}"
                                               FontSize="{DynamicResource {x:Static th:ThemeResourceKeys.ToolWindowTitleFontSize}}"
                                               FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="Window content" Foreground="{DynamicResource {x:Static th:ThemeResourceKeys.WindowContentForeground}}"
                                           Margin="{DynamicResource {x:Static th:ThemeResourceKeys.ToolWindowContentMargin}}" />
                            </Grid>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- ============ WPF built-in controls ============ -->
                <TextBlock Text="Other WPF controls (mixed mapping)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,12" Width="180">
                            <TextBlock Text="ComboBox" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Item one" />
                                <ComboBoxItem Content="Item two" />
                                <ComboBoxItem Content="Item three" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="160">
                            <TextBlock Text="ListBox" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox Height="90">
                                <ListBoxItem Content="Alpha" />
                                <ListBoxItem Content="Beta" />
                                <ListBoxItem Content="Gamma" />
