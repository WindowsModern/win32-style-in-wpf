<Window x:Class="ThemeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pt="clr-namespace:System.Windows.Controls;assembly=PresentationFramework.Theme"
        xmlns:th="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Theme"
        Title="PresentationFramework.Theme Gallery"
        Width="1120" Height="1320"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}"
        FontSize="{x:Static SystemFonts.MessageFontSize}"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Open..." />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" />
                <MenuItem Header="_Redo" />
                <Separator />
                <MenuItem Header="Cu_t" />
                <MenuItem Header="_Copy" />
                <MenuItem Header="_Paste" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" />
                <MenuItem Header="Zoom _Out" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <Separator />
            <StatusBarItem Content="PresentationFramework.Theme" />
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,12,20,20">
            <StackPanel>
                <TextBlock Text="Win32 theme for WPF" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="ModeText" Margin="0,4,0,2" Foreground="Gray" />
                <TextBlock Margin="0,2,0,12" Foreground="Gray"
                           Text="Mapped controls use the current UXTHEME parts; the state strip shows every state. Controls without a Win32 mapping still use the WPF built-in style." />

                <!-- ================= Mapped controls ================= -->
                <TextBlock Text="Mapped controls" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Button" Width="100" Height="30" Margin="0,0,8,8" />
                            <Button Content="Default" Width="100" Height="30" Margin="0,0,8,8" IsDefault="True" />
                            <Button Content="Disabled" Width="100" Height="30" Margin="0,0,8,8" IsEnabled="False" />
                            <RepeatButton Content="RepeatButton" Width="120" Height="30" Margin="0,0,8,8" />
                            <ToggleButton Content="ToggleButton" Width="120" Height="30" Margin="0,0,8,8" IsChecked="True" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <CheckBox Content="Unchecked" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Checked" IsChecked="True" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Indeterminate" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <CheckBox Content="Disabled" IsEnabled="False" Margin="0,0,18,8" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <RadioButton Content="Option A" GroupName="G1" IsChecked="True" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <RadioButton Content="Option B" GroupName="G1" Margin="0,0,18,8" VerticalAlignment="Center" />
                            <RadioButton Content="Disabled" GroupName="G2" IsEnabled="False" Margin="0,0,18,8" VerticalAlignment="Center" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBox Text="TextBox" Width="180" Margin="0,0,10,8" />
                            <TextBox Text="Read only" Width="180" IsReadOnly="True" Margin="0,0,10,8" />
                            <TextBox Text="Disabled" Width="180" IsEnabled="False" Margin="0,0,10,8" />
                            <PasswordBox x:Name="SamplePassword" Width="180" Margin="0,0,10,8" />
                            <RichTextBox Width="300" Height="80" Margin="0,0,10,8">
                                <FlowDocument>
                                    <Paragraph>RichTextBox uses the same Win32 Edit part as TextBox.</Paragraph>
                                </FlowDocument>
                            </RichTextBox>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ================= State strip ================= -->
                <TextBlock Text="Every Win32 state of the mapped parts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Button / BP_PUSHBUTTON (part 1)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="5 Default" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="100" Height="30" th:ThemeImage.Class="Button" th:ThemeImage.Part="1" th:ThemeImage.State="6" /><TextBlock Text="6 DefaultAnimating" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="CheckBox / BP_CHECKBOX (Button part 3)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="1" /><TextBlock Text="1 Unchecked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="5" /><TextBlock Text="5 Checked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="6" /><TextBlock Text="6 CheckedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="7" /><TextBlock Text="7 CheckedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="8" /><TextBlock Text="8 CheckedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="9" /><TextBlock Text="9 Mixed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="10" /><TextBlock Text="10 MixedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="11" /><TextBlock Text="11 MixedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="3" th:ThemeImage.State="12" /><TextBlock Text="12 MixedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="RadioButton / BP_RADIOBUTTON (Button part 2)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,10">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="1" /><TextBlock Text="1 Unchecked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="3" /><TextBlock Text="3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="5" /><TextBlock Text="5 Checked" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="6" /><TextBlock Text="6 CheckedHot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="7" /><TextBlock Text="7 CheckedPressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="16" Height="16" th:ThemeImage.Class="Button" th:ThemeImage.Part="2" th:ThemeImage.State="8" /><TextBlock Text="8 CheckedDisabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>

                        <TextBlock Text="TextBox / EP_EDITTEXT (Edit part 1)" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="2" /><TextBlock Text="2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="3" /><TextBlock Text="3 Focused" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="4" /><TextBlock Text="4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="160" Height="26" th:ThemeImage.Class="Edit" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="5 ReadOnly" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Raw parts: ScrollBar / GroupBox / Tab / Menu / Tooltip / Status" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="17" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Scroll up" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="17" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="1" th:ThemeImage.State="5" /><TextBlock Text="Scroll down" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="17" Height="55" th:ThemeImage.Class="Scrollbar" th:ThemeImage.Part="3" th:ThemeImage.State="1" /><TextBlock Text="Thumb" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="180" Height="70" th:ThemeImage.Class="Button" th:ThemeImage.Part="4" th:ThemeImage.State="1" /><TextBlock Text="GroupBox" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="120" Height="28" th:ThemeImage.Class="Tab" th:ThemeImage.Part="5" th:ThemeImage.State="3" /><TextBlock Text="Tab" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="22" th:ThemeImage.Class="Menu" th:ThemeImage.Part="14" th:ThemeImage.State="1" /><TextBlock Text="Menu item" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="40" th:ThemeImage.Class="Tooltip" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Tooltip" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:HackImage Width="200" Height="26" th:ThemeImage.Class="Status" th:ThemeImage.Part="1" th:ThemeImage.State="1" /><TextBlock Text="Status" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="ThemePart probe" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="TrackBar" PartId="9" StateId="1" Width="240" Height="18" /><TextBlock Text="TICS 9" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="TrackBar" PartId="10" StateId="1" Width="18" Height="100" /><TextBlock Text="TICSVERT 10" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="5" StateId="1" Width="200" Height="27" /><TextBlock Text="Combo RO 5" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="5" StateId="2" Width="200" Height="27" /><TextBlock Text="Combo RO 5 s2" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="1" Width="18" Height="22" /><TextBlock Text="DD 1 Normal" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="2" Width="18" Height="22" /><TextBlock Text="DD 2 Hot" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="3" Width="18" Height="22" /><TextBlock Text="DD 3 Pressed" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Combobox" PartId="1" StateId="4" Width="18" Height="22" /><TextBlock Text="DD 4 Disabled" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Header" PartId="2" StateId="1" Width="40" Height="22" /><TextBlock Text="Header 2" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                            <StackPanel Margin="0,0,10,6"><pt:ThemePart ClassName="Header" PartId="3" StateId="1" Width="40" Height="22" /><TextBlock Text="Header 3" FontSize="10" HorizontalAlignment="Center" /></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ WPF built-in controls ============ -->
                <TextBlock Text="Other WPF controls (mixed mapping)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border BorderBrush="#FFB8B8B8" BorderThickness="1" Padding="12" Margin="0,0,0,14">
                    <WrapPanel>
                        <StackPanel Margin="0,0,18,12" Width="180">
                            <TextBlock Text="ComboBox" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="0">
                                <ComboBoxItem Content="Item one" />
                                <ComboBoxItem Content="Item two" />
                                <ComboBoxItem Content="Item three" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="160">
                            <TextBlock Text="ListBox" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListBox Height="90">
                                <ListBoxItem Content="Alpha" />
                                <ListBoxItem Content="Beta" />
                                <ListBoxItem Content="Gamma" />
                            </ListBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="250">
                            <TextBlock Text="ListView" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ListView x:Name="SampleList" Height="100">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120" />
                                        <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="80" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="180">
                            <TextBlock Text="TreeView" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TreeView Height="100">
                                <TreeViewItem Header="Root" IsExpanded="True">
                                    <TreeViewItem Header="Child A" />
                                    <TreeViewItem Header="Child B" />
                                </TreeViewItem>
                            </TreeView>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="360">
                            <TextBlock Text="DataGrid" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <DataGrid x:Name="SampleGrid" Height="120" AutoGenerateColumns="False" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="220">
                            <TextBlock Text="Calendar / DatePicker" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Calendar Height="160" />
                            <DatePicker Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="200">
                            <TextBlock Text="Slider cases" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="H: None" FontSize="10" Foreground="Gray" />
                            <Slider Minimum="0" Maximum="100" Value="40" />
                            <TextBlock Text="H: TopLeft" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                            <Slider Minimum="0" Maximum="100" Value="40" TickPlacement="TopLeft" TickFrequency="10" />
                            <TextBlock Text="H: BottomRight" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                            <Slider Minimum="0" Maximum="100" Value="40" TickPlacement="BottomRight" TickFrequency="10" />
                            <TextBlock Text="H: Both" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                            <Slider Minimum="0" Maximum="100" Value="40" TickPlacement="Both" TickFrequency="20" />
                            <TextBlock Text="H: Disabled" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                            <Slider Minimum="0" Maximum="100" Value="40" IsEnabled="False" />
                            <TextBlock Text="V: None / Left / Right / Both" FontSize="10" Foreground="Gray" Margin="0,6,0,0" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <Slider Orientation="Vertical" Height="80" Minimum="0" Maximum="100" Value="40" />
                                    <TextBlock Text="None" FontSize="9" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <Slider Orientation="Vertical" Height="80" Minimum="0" Maximum="100" Value="40" TickPlacement="TopLeft" TickFrequency="10" />
                                    <TextBlock Text="Left" FontSize="9" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <Slider Orientation="Vertical" Height="80" Minimum="0" Maximum="100" Value="40" TickPlacement="BottomRight" TickFrequency="10" />
                                    <TextBlock Text="Right" FontSize="9" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel>
                                    <Slider Orientation="Vertical" Height="80" Minimum="0" Maximum="100" Value="40" TickPlacement="Both" TickFrequency="20" />
                                    <TextBlock Text="Both" FontSize="9" HorizontalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="ProgressBar" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <ProgressBar Height="18" Value="40" Maximum="100" />
                            <ProgressBar Height="18" Margin="0,5,0,0" Value="40" Maximum="100" Tag="Smooth" />
                            <ProgressBar Height="18" Margin="0,5,0,0" Value="40" Maximum="100" th:ThemeProgress.State="Paused" />
                            <ProgressBar Height="18" Margin="0,5,0,0" Value="40" Maximum="100" th:ThemeProgress.State="Error" />
                            <ProgressBar Height="18" Margin="0,5,0,0" IsIndeterminate="True" />
                            <TextBlock Text="chunked / smooth / paused / error / waiting" FontSize="10" Margin="0,3,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ProgressBar Orientation="Vertical" Width="18" Height="80" Value="40" Maximum="100" />
                                <ProgressBar Orientation="Vertical" Width="18" Height="80" Margin="8,0,0,0" Value="40" Maximum="100" Tag="Smooth" />
                                <ProgressBar Orientation="Vertical" Width="18" Height="80" Margin="8,0,0,0" Value="40" Maximum="100" th:ThemeProgress.State="Paused" />
                                <ProgressBar Orientation="Vertical" Width="18" Height="80" Margin="8,0,0,0" Value="40" Maximum="100" th:ThemeProgress.State="Error" />
                                <ProgressBar Orientation="Vertical" Width="18" Height="80" Margin="8,0,0,0" IsIndeterminate="True" />
                                <TextBlock Text="vertical chunked / smooth / paused / error / waiting" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="220">
                            <TextBlock Text="ScrollBar" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ScrollBar Orientation="Horizontal" Minimum="0" Maximum="100" Value="30" ViewportSize="10" />
                            <ScrollBar Orientation="Vertical" Height="70" Margin="0,8,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="30" ViewportSize="10" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="220">
                            <TextBlock Text="GroupBox" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <GroupBox Header="Group" Height="80">
                                <TextBlock Text="Content" Margin="4" />
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="220">
                            <TextBlock Text="Expander" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <Expander Header="Expanded" IsExpanded="True">
                                <TextBlock Text="Expander content" Margin="4" />
                            </Expander>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="300">
                            <TextBlock Text="TabControl" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TabControl Height="120" TabStripPlacement="Top">
                                <TabItem Header="Tab one">
                                    <TextBlock Text="First page" Margin="6" />
                                </TabItem>
                                <TabItem Header="Tab two">
                                    <TextBlock Text="Second page" Margin="6" />
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                        <StackPanel Margin="0,0,18,12" Width="300">
                            <TextBlock Text="ToolBar / Label / Hyperlink / Image / Separator" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ToolBar>
                                <Button Content="Cut" />
                                <Button Content="Copy" />
                                <Button Content="Paste" />
                            </ToolBar>
                            <Label Content="Label" Margin="0,6,0,0" />
                            <TextBlock Margin="0,6,0,0">
                                <Hyperlink NavigateUri="https://example.com">Hyperlink</Hyperlink>
                            </TextBlock>
                            <Image Width="24" Height="24" HorizontalAlignment="Left" Margin="0,6,0,0">
                                <Image.Source>
                                    <DrawingImage>
                                        <DrawingImage.Drawing>
                                            <GeometryDrawing Brush="SteelBlue" Geometry="M0,0 L20,0 L10,20 Z" />
                                        </DrawingImage.Drawing>
                                    </DrawingImage>
                                </Image.Source>
                            </Image>
                            <Separator Margin="0,8,0,0" />
                            <Button Content="ToolTip / ContextMenu" Margin="0,4,0,0">
                                <Button.ToolTip>
                                    <ToolTip Content="A Win32-themed tooltip host" />
                                </Button.ToolTip>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Context item" InputGestureText="Ctrl+C" />
                                        <MenuItem Header="Checked item" IsCheckable="True" IsChecked="True" />
                                        <MenuItem Header="Disabled item" IsEnabled="False" />
                                        <Separator />
                                        <MenuItem Header="Submenu">
                                            <MenuItem Header="Child one" />
                                            <MenuItem Header="Child two" IsCheckable="True" />
                                            <Separator />
                                            <MenuItem Header="Disabled child" IsEnabled="False" />
                                        </MenuItem>
                                        <MenuItem Header="Icon item">
                                            <MenuItem.Icon>
                                                <Rectangle Width="16" Height="16" Fill="#FF3B6EA5" Stroke="#FF1F4E79" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
